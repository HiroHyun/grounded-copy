{
  "name": "grounded-copy",
  "description": "Puts the grounded prose ruleset in session context at startup and repeats a one-line reminder each turn, so the rules reach chat replies as well as copy tasks.",
  "version": "0.1.0",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" grounded_activate.py --plugin-root \"${CLAUDE_PLUGIN_ROOT}\" --data-dir \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 5,
            "statusMessage": "Loading grounded prose rules..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" grounded_tracker.py --plugin-root \"${CLAUDE_PLUGIN_ROOT}\" --data-dir \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
