{
  "name": "grounded-copy",
  "description": "Help AI write clearly and get to the point.",
  "version": "0.7.3",
  "author": {
    "name": "HiroHyun",
    "url": "https://github.com/HiroHyun"
  },
  "homepage": "https://github.com/HiroHyun/grounded-copy",
  "repository": "https://github.com/HiroHyun/grounded-copy",
  "license": "AGPL-3.0-only",
  "keywords": ["writing", "plain-language", "style", "copywriting"],
  "skills": ["./skills/"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/claude_activate.cmd\"",
            "timeout": 5,
            "statusMessage": "Loading grounded prose rules..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/claude_tracker.cmd\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/claude_gate.cmd\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
