{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/hooks/run.sh\" grounded_activate.py",
            "commandWindows": "cmd /d /c \" `\"$env:PLUGIN_ROOT\\hooks\\run.cmd`\" grounded_activate.py\"; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/hooks/run.sh\" grounded_tracker.py",
            "commandWindows": "cmd /d /c \" `\"$env:PLUGIN_ROOT\\hooks\\run.cmd`\" grounded_tracker.py\"; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/hooks/run.sh\" grounded_gate.py",
            "commandWindows": "cmd /d /c \" `\"$env:PLUGIN_ROOT\\hooks\\run.cmd`\" grounded_gate.py\"; exit $LASTEXITCODE"
          }
        ]
      }
    ]
  }
}
